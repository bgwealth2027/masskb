# 下面的 localhost 地址给宿主机虚拟环境。
# 应用容器不读 QDRANT_URL / NEO4J_URI；Compose 的 app 服务固定使用
# http://qdrant:6333 与 bolt://neo4j:7687。
# 容器里的 NEO4J_PASSWORD 来自 NEO4J_DEV_PASSWORD，默认 masskb-dev-pass，不写进镜像。
# 只在要替换该开发密码时取消下一行注释，并让 NEO4J_PASSWORD 与它相同。
# 不要提交生产密码。
# NEO4J_DEV_PASSWORD=masskb-dev-pass

# Qdrant vector database
QDRANT_URL=http://localhost:6333

# Neo4j graph database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# OpenAI-compatible LLM API
# OPENAI_API_KEY 只放在这份不提交的 .env 或当前 shell。
# Compose 会把它传给 app，不会写进镜像。占位符仍视为未配置。
OPENAI_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1

# Optional embedding / model settings
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o-mini

# 可选本机嵌入。默认不启用，仍走上面的 LLM_BASE_URL 与 text-embedding-3-small（1536 维）。
# 启用：docker compose --profile embed up
# 宿主机 CLI：
# EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
# 应用容器不读上一行，只读 Compose 变量（与 QDRANT_URL 的分工相同）：
# COMPOSE_EMBEDDING_BASE_URL=http://embed:8080/v1
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_DIMENSIONS=512
# 换模型或维度前先删除 Qdrant 集合 masskb_chunks，再全量重新 ingest。程序不会自动删集合。
# 本机嵌入不需要真实 OPENAI_API_KEY；问答、改写、重排、实体和 ask 仍需要。
# HF_TOKEN 只放在不提交的 .env，留给受限模型。默认模型是公开的，留空即可。
# HF_TOKEN=
